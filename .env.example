# === Required ===
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# === Database ===
# SQLite (default):
DATABASE_URL=sqlite:///./reviews.db
# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql://pr_agent:changeme@localhost:5432/pr_reviews

# === LLM ===
# Primary model provider: "groq" or "gemini"
LLM_PRIMARY=groq
# Fallback if primary fails
LLM_FALLBACK=gemini

# === Review Behavior ===
# Set to true to use multi-pass agentic reviewer (security + bugs + performance)
AGENTIC_MODE=false
# Max diff lines per file before truncation
MAX_DIFF_LINES_PER_FILE=1000

# === Job Queue (optional) ===
# Set to true to use Redis/Celery for background processing
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
